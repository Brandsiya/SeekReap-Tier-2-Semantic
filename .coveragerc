[run]
source = tier2_core
omit = 
    */__pycache__/*
    */test_*
    */tests/*
    setup.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    @property
    @abstractmethod
    class .*\(.*\):
    pass

fail_under = 80
show_missing = True
skip_covered = False

[html]
directory = coverage_html
title = Tier-2 Test Coverage
